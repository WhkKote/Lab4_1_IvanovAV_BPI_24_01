<Window x:Class="Lab4_1_IvanovAV_BPI_24_01.View.WindowEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="400" Width="670">

    <DockPanel>

        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top">

            <Button Content="Добавить"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding AddPerson}"/>

            <Button Content="Редактировать"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding EditPerson}"/>

            <Button Content="Удалить"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding DeletePerson}"/>

        </StackPanel>

        <ListView x:Name="lvEmployee"
                  ItemsSource="{Binding ListPersonDpo}"
                  SelectedItem="{Binding SelectedPersonDpo, Mode=TwoWay}">

            <ListView.View>
                <GridView>
                    <GridView.Columns>

                        <GridViewColumn Header="Код"
                                        Width="50"
                                        DisplayMemberBinding="{Binding Id}"/>

                        <GridViewColumn Header="Фамилия"
                                        Width="120"
                                        DisplayMemberBinding="{Binding LastName}"/>

                        <GridViewColumn Header="Имя"
                                        Width="110"
                                        DisplayMemberBinding="{Binding FirstName}"/>

                        <GridViewColumn Header="Должность"
                                        Width="135"
                                        DisplayMemberBinding="{Binding RoleName}"/>

                        <GridViewColumn Header="Дата рождения"
                                        Width="125"
                                        DisplayMemberBinding="{Binding Birthday, StringFormat={}{0:dd\.}{0:MM\.}{0:yyyy}}"/>

                    </GridView.Columns>
                </GridView>
            </ListView.View>

        </ListView>

    </DockPanel>
</Window>
