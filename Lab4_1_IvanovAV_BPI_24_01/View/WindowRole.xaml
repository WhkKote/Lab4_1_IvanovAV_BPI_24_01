<Window x:Class="Lab4_1_IvanovAV_BPI_24_01.View.WindowRole"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Должности" Height="350" Width="420">

    <DockPanel>

        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Top">

            <Button Content="Добавить"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding AddRole}"/>

            <Button Content="Редактировать"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding EditRole}"/>

            <Button Content="Удалить"
                    Height="25"
                    Margin="10,10,5,10"
                    Command="{Binding DeleteRole}"/>

        </StackPanel>

        <Label DockPanel.Dock="Top"
               Margin="5"
               HorizontalAlignment="Center">
            Список должностей сотрудников
        </Label>

        <ListView x:Name="lvRole"
                  ItemsSource="{Binding ListRole}"
                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}">

            <ListView.View>
                <GridView>
                    <GridView.Columns>

                        <GridViewColumn Header="Код"
                                        Width="50"
                                        DisplayMemberBinding="{Binding Id}"/>

                        <GridViewColumn Header="Наименование должности"
                                        Width="235"
                                        DisplayMemberBinding="{Binding NameRole}"/>

                    </GridView.Columns>
                </GridView>
            </ListView.View>

        </ListView>

    </DockPanel>
</Window>
